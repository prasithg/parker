<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Merged into the bundle's Info.plist by tauri-build. The mic usage
       string is what macOS shows in the TCC permission prompt the
       onboarding wizard triggers with its level check. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Parker uses the microphone to understand speech and provide voice-practice feedback. Conversation audio is transcribed locally and discarded; voice-practice recordings are saved locally only when you choose.</string>
  <!-- Menu-bar app: no Dock icon, no Cmd-Tab entry. -->
  <key>LSUIElement</key>
  <true/>
</dict>
</plist>
