# Local family digests (make digest) — artifacts stay on this machine.
backend/digests/
# Local weekly outcome rollups (make rollup) — aggregates stay on this machine.
backend/rollups/
# Local converse latency receipts (Patient Curiosity Loop) — stay on this machine.
backend/receipts/
# Optional Voice Practice recordings and local derived artifacts.
backend/voice-practice/
# Whisper weights when a dev checkout has no HF cache (PARKER_HOME/models).
backend/models/
# Python packaging metadata from `pip install -e backend`.
backend/*.egg-info/
# PyInstaller sidecar build artifacts (the .spec IS committed).
backend/build/
backend/dist/
# Build identity stamped by `make sidecar` (app/version.py write_build_info).
backend/app/_build_info.py
